# LiveKit Cloud (free tier works): https://cloud.livekit.io
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Synthesia workspace API key with Interactive Avatars enabled
SYNTHESIA_API_KEY=
# Optional: your own avatar's ID
SYNTHESIA_AVATAR_ID=

# Optional: Cartesia voice ID (defaults to "Kabir", a male Hindi voice that also speaks English)
CARTESIA_VOICE_ID=

# How Irfan talks: hinglish (default, simple Hindi + simple English) or english
NICO_LANGUAGE=hinglish

# Noisy room / live stage. 0 = always listening (online demos).
# clicker = tap SPACE or a presenter clicker's Next/Previous button to start talking, tap again to finish.
# auto = hands-free, but tuned for noise: stricter voice detection, ignores short chatter, can't be interrupted.
NICO_STAGE_MODE=0
